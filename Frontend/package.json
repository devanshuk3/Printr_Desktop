{
  "name": "printr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "npm run dev",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.printr.app",
    "productName": "Printr",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.4",
    "electron-builder": "^24.13.3",
    "typescript": "~5.9.3",
    "vite": "^5.4.11",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "lucide-react": "^1.7.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "unix-print": "^1.3.2"
  }
}
